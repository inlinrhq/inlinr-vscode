{
  "name": "inlinr-vscode",
  "displayName": "inlinr",
  "description": "Time tracking for developers with AI-tool attribution. First-party VS Code extension for inlinr.com.",
  "version": "0.5.4",
  "publisher": "inlinr",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/inlinrhq/inlinr-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "keywords": [
    "time tracking",
    "productivity",
    "wakatime",
    "ai",
    "copilot",
    "cursor",
    "claude"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inlinr.signIn",
        "title": "inlinr: Sign in"
      },
      {
        "command": "inlinr.signOut",
        "title": "inlinr: Sign out"
      },
      {
        "command": "inlinr.dashboard",
        "title": "inlinr: Open dashboard"
      },
      {
        "command": "inlinr.doctor",
        "title": "inlinr: Doctor"
      },
      {
        "command": "inlinr.toggleStatusBar",
        "title": "inlinr: Toggle status bar"
      }
    ],
    "configuration": {
      "title": "inlinr",
      "properties": {
        "inlinr.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show today's coding time in the status bar."
        },
        "inlinr.trackFoldersWithoutGit": {
          "type": "boolean",
          "default": true,
          "description": "Track a folder with no git remote under its folder name. Only the name is sent, never the path."
        },
        "inlinr.debug": {
          "type": "boolean",
          "default": false,
          "description": "Pass --log-file to the CLI and print its output to the inlinr output channel."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "build:icon": "bun run scripts/build-icon.mjs",
    "watch": "bun run build -- --watch",
    "package": "vsce package",
    "test": "vitest run"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
